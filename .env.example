# KOPIS 오픈API 서비스키  https://kopis.or.kr
KOPIS_KEY=

# 슬랙 Incoming Webhook URL (비우면 콘솔로만 출력)
SLACK_WEBHOOK=

# 수집 범위
LOOKAHEAD_DAYS=180

# 관심 지역 (우선순위일 뿐, 필터가 아니다. 전국을 다 수집하고 이 지역을 먼저 보여준다)
REGION_PRIORITY=서울특별시,경기도,인천광역시,대전광역시,세종특별자치시,충청남도,충청북도
# 알림 보낼 채널. 공개 채널이면 chat:write.public 덕에 봇 초대가 필요 없다.
SLACK_CHANNEL=
