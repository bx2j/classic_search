# ─────────────────────────────────────────────────────────────
# concert-watch 설정. 이 파일을 .env 로 복사해서 값을 채운다.
#   cp .env.example .env && chmod 600 .env
# .env 는 .gitignore 에 있으므로 깃에 올라가지 않는다.
# ─────────────────────────────────────────────────────────────

# [필수] KOPIS 오픈API 서비스키
#   https://kopis.or.kr → 오픈API 활용신청
KOPIS_KEY=

# ── 슬랙 알림 ────────────────────────────────────────────────
# 아래 두 방식 중 하나만 채우면 된다. 봇 토큰이 있으면 그쪽을 먼저 쓴다.
# 둘 다 비우면 콘솔로만 출력한다(알림 안 감).

# [방식 A · 권장] 봇 토큰
#   api.slack.com/apps → 앱 → OAuth & Permissions → Bot User OAuth Token
#   필요한 스코프: chat:write
#   chat:write.public 이 있으면 공개 채널은 봇을 초대하지 않아도 된다.
SLACK_BOT_TOKEN=

# 알림 보낼 채널. '#' 를 포함해 채널명을 그대로 적는다. 예: #classic_search
#   비공개 채널이면 그 채널에서 /invite @봇이름 을 해줘야 한다.
SLACK_CHANNEL=

# [방식 B] Incoming Webhook URL
#   api.slack.com/apps → 앱 → Incoming Webhooks → Add New Webhook to Workspace
#   채널이 URL에 고정되므로 SLACK_CHANNEL 은 필요 없다.
SLACK_WEBHOOK=

# 현재 코드는 이 값을 사용하지 않는다. 나중에 Socket Mode(슬랙에서 직접 검색)를
# 붙일 때 필요해서 자리만 잡아둔 것이다. 비워둬도 된다.
SLACK_APP_TOKEN=

# ── 수집 설정 ────────────────────────────────────────────────
# 오늘부터 몇 일 뒤까지 수집할지
LOOKAHEAD_DAYS=180

# 관심 지역. 필터가 아니라 우선순위다.
# 전국을 다 수집하되 이 지역을 먼저 보강하고 먼저 보여준다.
REGION_PRIORITY=서울특별시,경기도,인천광역시,대전광역시,세종특별자치시,충청남도,충청북도
